# Copy this file to `.env` and fill in real values.
# Never commit real values. `.env` is git-ignored.

# ---- Server ----
PORT=8000
NODE_ENV=development

# ---- JWT (single canonical secret after Phase 1) ----
# REQUIRED. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Access token lifetime. Default 15m. Increase (e.g. 7d) only until refresh
# tokens are implemented (Phase 2).
JWT_ACCESS_EXPIRES_IN=15m

# Refresh-token secret. REQUIRED in production (min 32 characters).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development an ephemeral secret is used if this is left empty, so refresh
# sessions do not survive a server restart.
REFRESH_TOKEN_SECRET=

# Legacy variables, no longer used after Phase 1:
# JWT_EXPIRE=
# SECRET_KEY=

# ---- MongoDB ----
# REQUIRED
MONGO_URI=

# ---- ImageKit ----
# REQUIRED (server fails to start without these)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ---- Cloudinary (optional feature credentials; uploads fail clearly if missing) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Backblaze B2 (optional feature credentials; uploads fail clearly if missing) ----
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_URL=
B2_PUBLIC_BUCKET_URL=

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=

# ---- Admin ----
# Admin registration setup key (Phase 4 / F09).
# Required in production for POST /api/admin/register. In development,
# registration is allowed without a key only when this is left empty.
# Never hardcode a real secret.
ADMIN_REGISTER_KEY=
